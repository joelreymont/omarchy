#!/bin/bash

# omarchy:summary=Returns 0 in clamshell mode, 1 when not, 2 when the lid state is unknown
# omarchy:hidden=true

# Clamshell = lid closed while driving one or more external monitors.
#
# A lid switch bind that runs a handler knows the transition it is handling
# and passes it in OMARCHY_LID; the platform's own view (logind on machines
# without ACPI) may not have caught up with that very event yet.
lid_closed() {
  case ${OMARCHY_LID-} in
  closed) return 0 ;;
  open) return 1 ;;
  esac
  omarchy-hw-laptop-closed
}

# No external monitor means no clamshell whatever the lid is doing, and that
# check reads sysfs, so it always answers once it runs. Only then does the lid
# decide; a lid that could not be read (2) passes through as-is rather than as
# open, and so does a helper that could not start.
omarchy-hw-external-monitors
case $? in
  0) ;;
  1) exit 1 ;;
  *) exit 2 ;;
esac
lid_closed
