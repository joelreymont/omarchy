#!/bin/bash

# omarchy:summary=Show, set, or adjust Hyprland monitor scaling
# omarchy:args=[--monitor NAME] [up|down|SCALE]
# omarchy:examples=omarchy hyprland monitor scaling | omarchy hyprland monitor scaling 1.6 | omarchy hyprland monitor scaling up | omarchy hyprland monitor scaling --monitor DP-1 1.25

SCALES=(1 1.25 1.6 2 3 4)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
SCALE_LOG="$STATE_DIR/monitor-scaling.log"

# Monitor to operate on; empty means the focused one.
TARGET_MONITOR=""

usage() {
  echo "Usage: omarchy-hyprland-monitor-scaling [--monitor NAME] [up|down|SCALE]"
}

target_monitor_json() {
  if [[ -n $TARGET_MONITOR ]]; then
    hyprctl monitors -j | jq -e -c --arg name "$TARGET_MONITOR" '[.[] | select(.name == $name)][0] // empty'
  else
    hyprctl monitors -j | jq -e -c '[.[] | select(.focused == true)][0] // empty'
  fi
}

target_monitor_scale() {
  target_monitor_json | jq -er '.scale'
}

cmdline_for_pid() {
  local pid="$1"

  [[ -r /proc/$pid/cmdline ]] || return 0
  tr '\0\t\n' '   ' <"/proc/$pid/cmdline" | sed -E 's/[[:space:]]+/ /g; s/[[:space:]]+$//'
}

audit_scale_change() {
  local requested="$1"
  local active_monitor="$2"
  local current_scale="$3"
  local new_scale="$4"
  local parent_pid="$PPID"
  local grandparent_pid
  local parent_cmd
  local grandparent_cmd

  mkdir -p "$STATE_DIR" || return 0

  grandparent_pid=$(ps -o ppid= -p "$parent_pid" 2>/dev/null | tr -d ' ')
  parent_cmd=$(cmdline_for_pid "$parent_pid")
  grandparent_cmd=$(cmdline_for_pid "$grandparent_pid")

  printf 'at=%s\trequested=%s\tcurrent=%s\tnew=%s\tmonitor=%s\tpid=%s\tppid=%s\tparent=%s\tgppid=%s\tgrandparent=%s\n' \
    "$(date --iso-8601=seconds)" \
    "$requested" \
    "$current_scale" \
    "$new_scale" \
    "$active_monitor" \
    "$$" \
    "$parent_pid" \
    "$parent_cmd" \
    "$grandparent_pid" \
    "$grandparent_cmd" >>"$SCALE_LOG"
}

# Hyprland only accepts scales where the mode divides into whole logical
# pixels (in 1/120 steps), so clean scales are divisors of gcd(w*120, h*120).
# Round the requested scale up to the nearest clean value.
clean_scale() {
  awk -v scale="$1" -v width="$2" -v height="$3" '
    function gcd(a, b, t) { while (b) { t = a % b; a = b; b = t } return a }
    BEGIN {
      g = gcd(width * 120, height * 120)
      k = int(scale * 120 + 0.5)
      if (k > g) k = g
      while (g % k != 0) k++
      printf "%g\n", k / 120
    }'
}

normalize_scale() {
  awk 'NR == 1 { printf "%g\n", $0 }'
}

set_scale() {
  local requested_scale="$1"
  local requested="${2:-$requested_scale}"
  local monitor_info="$(target_monitor_json)"

  if [[ -z $monitor_info ]]; then
    echo "No such monitor: ${TARGET_MONITOR:-focused}" >&2
    exit 1
  fi

  local active_monitor="$(echo "$monitor_info" | jq -r '.name')"
  local current_scale="$(echo "$monitor_info" | jq -r '.scale')"
  local width="$(echo "$monitor_info" | jq -r '.width')"
  local height="$(echo "$monitor_info" | jq -r '.height')"
  local refresh_rate="$(echo "$monitor_info" | jq -r '.refreshRate')"
  local description="$(echo "$monitor_info" | jq -r '.description // ""')"

  # active_monitor is written into the Lua string eval'd below, so only a plain
  # connector name may pass; a hostile output name could execute otherwise.
  if [[ ! $active_monitor =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Refusing unsafe monitor name" >&2
    exit 1
  fi

  # The description lands inside a quoted Lua string when a rule is pinned;
  # drop it if it could escape the quotes.
  [[ $description == *[\"\\]* ]] && description=""

  local new_scale="$(clean_scale "$requested_scale" "$width" "$height")"
  # GTK only honors integer GDK_SCALE values, so persist the nearest whole
  # factor even when the monitor scale itself is fractional.
  local new_gdk_scale="$(awk -v scale="$new_scale" 'BEGIN { printf "%d", int(scale + 0.5) }')"
  local monitor_lua="$HOME/.config/hypr/monitors.lua"
  local all_monitors_json="$(hyprctl monitors all -j)"

  # A description identifies a monitor across connectors only when no other
  # attached display shares it (twins of one model without a serial do).
  if [[ -n $description ]]; then
    local desc_count="$(jq --arg d "$description" '[.[] | select(.description == $d)] | length' <<<"$all_monitors_json")"
    [[ $desc_count -eq 1 ]] || description=""
  fi

  hyprctl eval "hl.monitor({ output = \"$active_monitor\", mode = \"${width}x${height}@${refresh_rate}\", position = \"auto\", scale = $new_scale })" >/dev/null
  audit_scale_change "$requested" "$active_monitor" "$current_scale" "$new_scale"

  # monitors.lua is edited through its resolved target (it is a symlink into
  # the user's dotfiles on some setups) and replaced atomically, so a reload
  # racing this write reads either the old or the new configuration, never
  # a truncated one.
  rewrite_monitor_lua() {
    local target tmp
    target="$(readlink -f "$monitor_lua")" || return 1
    tmp="$(mktemp -p "$(dirname "$target")" .monitors.lua.XXXXXX)" || return 1
    if "$@" "$target" >"$tmp" && chmod --reference="$target" "$tmp" && mv -f "$tmp" "$target"; then
      return 0
    fi
    rm -f "$tmp"
    return 1
  }

  # Comments are stripped before a rule is matched, so a commented example
  # or a trailing comment naming another output is never taken for a rule.
  # awk matches the needle as a fixed string so descriptions with regex
  # metacharacters stay safe.
  rule_exists() {
    sed -e 's/--.*$//' "$monitor_lua" | grep -qF "$1"
  }
  update_rule_scale() {
    rewrite_monitor_lua awk -v needle="$1" -v scale="$new_scale" '
      { rule = $0; sub(/--.*$/, "", rule) }
      rule ~ /^[[:space:]]*hl\.monitor\(/ && index(rule, needle) { sub(/scale = ("auto"|[0-9.]+)/, "scale = " scale) }
      { print }
    '
  }
  append_rule() {
    rewrite_monitor_lua awk -v rule="$1" '{ print } END { print rule }'
  }

  # Persist so the scale survives reboots. A rule that names this monitor (by
  # EDID description or by connector) is updated in place. Without one, the
  # generic defaults - Omarchy's scale knob, else the catch-all rule - are
  # rewritten only when this is the only display attached at all, disabled
  # ones included: they govern every display without a rule of its own, and
  # a change aimed at one of several (a clamshelled laptop's external, say)
  # must not become the default the others inherit. Then the monitor gets
  # pinned with a rule of its own.
  local desc_needle="output = \"desc:${description}\""
  local name_needle="output = \"${active_monitor}\""
  local attached_count="$(jq 'length' <<<"$all_monitors_json")"

  if [[ ! -f $monitor_lua ]]; then
    :
  elif [[ -n $description ]] && rule_exists "$desc_needle"; then
    update_rule_scale "$desc_needle"
  elif rule_exists "$name_needle"; then
    update_rule_scale "$name_needle"
  elif [[ $attached_count -eq 1 ]] && grep -q '^local omarchy_monitor_scale = ' "$monitor_lua"; then
    rewrite_monitor_lua sed -E \
      -e "s|^local omarchy_monitor_scale = .*|local omarchy_monitor_scale = ${new_scale}|"
  elif [[ $attached_count -eq 1 ]] && grep -Eq '^hl\.monitor\(\{ output = "", mode = "preferred", position = "auto", scale = ("auto"|[0-9.]+) \}\)' "$monitor_lua"; then
    rewrite_monitor_lua sed -E \
      -e "s|^(hl\.monitor\(\{ output = \"\", mode = \"preferred\", position = \"auto\", scale = )([^ ]+)( \}\))|\\1${new_scale}\\3|"
  else
    local out="$active_monitor"
    [[ -n $description ]] && out="desc:${description}"
    append_rule "$(printf 'hl.monitor({ output = "%s", mode = "%sx%s@%s", position = "auto", scale = %s })' \
      "$out" "$width" "$height" "$refresh_rate" "$new_scale")"
  fi

  # GDK_SCALE is one global value for GTK: it follows the built-in panel, or
  # the only display when the machine has none.
  local has_internal="$(jq '[.[] | select(.name | test("^(eDP|LVDS|DSI)-"))] | length' <<<"$all_monitors_json")"
  if [[ -f $monitor_lua ]] && { [[ $attached_count -eq 1 ]] || [[ $active_monitor =~ ^(eDP|LVDS|DSI)- ]]; }; then
    rewrite_monitor_lua sed -E \
      -e "s|^local omarchy_gdk_scale = .*|local omarchy_gdk_scale = ${new_gdk_scale}|" \
      -e 's|^hl\.env\("GDK_SCALE", ".*"\)|hl.env("GDK_SCALE", "'"$new_gdk_scale"'")|'
  fi
}

scale_from_current() {
  local direction="${1:-}"
  local width="${2:-}"
  local height="${3:-}"

  awk -v direction="$direction" -v list="${SCALES[*]}" -v width="$width" -v height="$height" '
    function gcd(a, b, t) { while (b) { t = a % b; a = b; b = t } return a }
    function clean(scale,    g, k) {
      g = gcd(width * 120, height * 120)
      k = int(scale * 120 + 0.5)
      if (k > g) k = g
      while (g % k != 0) k++
      return k / 120
    }
    NR == 1 { scale = $0; found = 1 }
    END {
      if (!found) exit 1

      preset_count = split(list, presets, " ")
      for (i = 1; i <= preset_count; i++) {
        effective = clean(presets[i])
        key = sprintf("%.8f", effective)
        distance = presets[i] - effective
        if (distance < 0) distance = -distance

        # Multiple presets can collapse to the same clean scale. Keep only the
        # closest label so stepping always moves to a distinct effective value.
        if (!(key in effective_index)) {
          effective_index[key] = ++n
          effective_scales[n] = effective
          scales[n] = presets[i]
          distances[n] = distance
        } else {
          idx = effective_index[key]
          if (distance < distances[idx]) {
            scales[idx] = presets[i]
            distances[idx] = distance
          }
        }
      }

      # Snap to the nearest effective scale first. Hyprland reports floating
      # point values, so exact comparisons can otherwise get stuck.
      best = 1; best_diff = 1e9
      for (i = 1; i <= n; i++) {
        diff = scale - effective_scales[i]; if (diff < 0) diff = -diff
        if (diff < best_diff) { best_diff = diff; best = i }
      }

      if (direction == "next") {
        print scales[(best < n ? best + 1 : n)]
      } else if (direction == "previous") {
        print scales[(best > 1 ? best - 1 : 1)]
      } else {
        print scales[best]
      }
    }'
}

args=()
while (($#)); do
  case "$1" in
  --monitor)
    [[ $# -ge 2 ]] || { usage >&2; exit 1; }
    TARGET_MONITOR="$2"
    shift 2
    ;;
  --monitor=*)
    TARGET_MONITOR="${1#--monitor=}"
    shift
    ;;
  *)
    args+=("$1")
    shift
    ;;
  esac
done
set -- "${args[@]}"

case "${1:-}" in
"")
  target_monitor_scale | normalize_scale
  ;;
-h | --help)
  usage
  ;;
up)
  monitor_info=$(target_monitor_json)
  set_scale "$(echo "$monitor_info" | jq -r '.scale' | scale_from_current next \
    "$(echo "$monitor_info" | jq -r '.width')" "$(echo "$monitor_info" | jq -r '.height')")" "up"
  ;;
down)
  monitor_info=$(target_monitor_json)
  set_scale "$(echo "$monitor_info" | jq -r '.scale' | scale_from_current previous \
    "$(echo "$monitor_info" | jq -r '.width')" "$(echo "$monitor_info" | jq -r '.height')")" "down"
  ;;
1 | 1.25 | 1.6 | 2 | 3 | 4)
  set_scale "$1" "$1"
  ;;
*)
  if [[ $1 =~ ^[0-9]+([.][0-9]+)?$ ]] &&
    awk -v scale="$1" 'BEGIN { exit !(scale >= 1 && scale <= 4) }'; then
    set_scale "$1" "$1"
  else
    usage >&2
    exit 1
  fi
  ;;
esac
