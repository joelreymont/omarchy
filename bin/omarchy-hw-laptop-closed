#!/bin/bash

# omarchy:summary=Returns 0 when the laptop lid is closed, 1 when open, 2 when nothing can say
# omarchy:hidden=true

# ACPI is authoritative where it exists: a platform with an ACPI lid answers
# from its state file, and one that reads neither open nor closed is no answer
# rather than a reason to ask elsewhere. Only a platform without any ACPI lid
# (devicetree machines such as Apple Silicon, where the lid is an SW_LID input
# switch) asks logind, which tracks that switch for every platform.
acpi_lid_dir="${OMARCHY_ACPI_LID_DIR:-/proc/acpi/button/lid}"
acpi_present=false
acpi_unanswered=false
for state in "$acpi_lid_dir"/*/state; do
  [[ -e $state ]] || continue
  acpi_present=true
  if [[ -r $state ]] && reading=$(< "$state") && [[ $reading =~ ^state:[[:space:]]+(open|closed)[[:space:]]*$ ]]; then
    [[ ${BASH_REMATCH[1]} == "closed" ]] && exit 0
  else
    acpi_unanswered=true
  fi
done
if [[ $acpi_present == true ]]; then
  # Any lid reading closed settled it above. Open needs every lid to say so:
  # one that could not be read might be the closed one.
  [[ $acpi_unanswered == true ]] && exit 2
  exit 1
fi

# Only logind's two answers count, and only from a query that succeeded. When
# it cannot be asked -- the bus is down, or busctl itself cannot start while a
# package transaction replaces its libraries -- "open" would be a guess, and
# the clamshell poll acting on that guess re-enables the panel behind a closed
# lid. Answer 2 so a caller can hold its state instead.
lid=$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
  org.freedesktop.login1.Manager LidClosed 2>/dev/null) || exit 2
case $lid in
  "b true") exit 0 ;;
  "b false") exit 1 ;;
esac

exit 2
